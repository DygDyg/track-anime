 "/api/v1/titles": {
 "get": {
 "security": [
 {
 "BearerAuth": []
 }
 ],
 "description": "Список тайтлов с фильтрами и пагинацией. Параметр-идентификатор\n(id, kinopoisk_id, imdb_id, mal_id, mdl_id), присланный пустым или из\nодних пробелов, отклоняется 400 вместо выборки всего каталога.",
 "consumes": [
 "application/json"
 ],
 "produces": [
 "application/json"
 ],
 "tags": [
 "Тайтлы"
 ],
 "summary": "Список тайтлов",
 "parameters": [
 {
 "enum": [
 "movie",
 "tv"
 ],
 "type": "string",
 "description": "Тип: movie — фильм, tv — сериал",
 "name": "type",
 "in": "query"
 },
 {
 "type": "string",
 "description": "ID тайтлов через запятую",
 "name": "id",
 "in": "query"
 },
 {
 "type": "string",
 "description": "Коды жанров через запятую — вернёт тайтлы с любым из них; коды берите в /titles/filters",
 "name": "genres",
 "in": "query"
 },
 {
 "type": "string",
 "description": "Коды стран через запятую — вернёт тайтлы с любой из них; коды берите в /titles/filters",
 "name": "countries",
 "in": "query"
 },
 {
 "enum": [
 "anime",
 "dorama",
 "turkey",
 "west"
 ],
 "type": "string",
 "description": "Направление: anime — аниме, dorama — дорама, turkey — турецкое, west — западное",
 "name": "direction",
 "in": "query"
 },
 {
 "enum": [
 "created_at_desc",
 "created_at_asc",
 "updated_at_desc",
 "updated_at_asc",
 "year_desc",
 "year_asc",
 "name_asc",
 "name_desc"
 ],
 "type": "string",
 "default": "created_at_desc",
 "description": "Сортировка. Для инкрементальной синхронизации используйте updated_at_asc вместе с updated_since",
 "name": "sort",
 "in": "query"
 },
 {
 "type": "string",
 "description": "Курсор пагинации — значение next_cursor из предыдущего ответа",
 "name": "cursor",
 "in": "query"
 },
 {
 "maximum": 100,
 "minimum": 1,
 "type": "integer",
 "default": 20,
 "description": "Размер страницы",
 "name": "limit",
 "in": "query"
 },
 {
 "type": "string",
 "description": "Вернуть только тайтлы, изменённые после этой даты. Формат RFC3339, например 2026-01-15T00:00:00Z. Пара с sort=updated_at_asc даёт детерминированный курсор по времени изменения",
 "name": "updated_since",
 "in": "query"
 },
 {
 "maximum": 2100,
 "minimum": 1900,
 "type": "integer",
 "description": "Год выпуска, от",
 "name": "year_from",
 "in": "query"
 },
 {
 "maximum": 2100,
 "minimum": 1900,
 "type": "integer",
 "description": "Год выпуска, до",
 "name": "year_to",
 "in": "query"
 },
 {
 "maximum": 10,
 "minimum": 0,
 "type": "number",
 "description": "Рейтинг, от",
 "name": "rating_from",
 "in": "query"
 },
 {
 "maximum": 10,
 "minimum": 0,
 "type": "number",
 "description": "Рейтинг, до",
 "name": "rating_to",
 "in": "query"
 },
 {
 "type": "string",
 "description": "Внешний ID Кинопоиска (точное совпадение)",
 "name": "kinopoisk_id",
 "in": "query"
 },
 {
 "type": "string",
 "description": "Внешний ID IMDb (точное совпадение)",
 "name": "imdb_id",
 "in": "query"
 },
 {
 "type": "string",
 "description": "Внешний ID MyAnimeList (точное совпадение)",
 "name": "mal_id",
 "in": "query"
 },
 {
 "type": "string",
 "description": "Внешний ID MyDramaList (точное совпадение)",
 "name": "mdl_id",
 "in": "query"
 },
 {
 "type": "boolean",
 "description": "Лицензия: true — только лицензионные, false — только нелицензионные; без параметра — все",
 "name": "licensed",
 "in": "query"
 },
 {
 "type": "boolean",
 "description": "Добавить в ответ общее количество",
 "name": "with_count",
 "in": "query"
 }
 ],
 "responses": {
 "200": {
 "description": "OK",
 "schema": {
 "$ref": "#/definitions/response.TitleList"
 }
 },
 "400": {
 "description": "Bad Request",
 "schema": {
 "$ref": "#/definitions/httputil.ErrorResponse"
 }
 },
 "401": {
 "description": "Unauthorized",
 "schema": {
 "$ref": "#/definitions/httputil.ErrorResponse"
 }
 },
 "500": {
 "description": "Internal Server Error",
 "schema": {
 "$ref": "#/definitions/httputil.ErrorResponse"
 }
 }
 }
 }
 },
