generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Настройки автоматической проверки обновлений Kodik
model KodikSyncSettings {
  id              String    @id @default("default")
  enabled         Boolean   @default(true)
  intervalMinutes Int       @default(10)
  syncPages       Int       @default(3)
  lastAutoRunAt   DateTime?
  updatedAt       DateTime  @updatedAt
}

/// Кэш обложек (/api/cover)
model CoverCacheSettings {
  id                String   @id @default("default")
  enabled           Boolean  @default(true)
  maxAgeDays        Int      @default(7)
  quality           Int      @default(70)
  maxHeight         Int      @default(450)
  browserCacheDays  Int      @default(7)
  updatedAt         DateTime @updatedAt
}

/// Хост Shikimori (API, OAuth, ссылки на сайт)
model ShikimoriSettings {
  id        String   @id @default("default")
  host      String   @default("shikimori.io")
  updatedAt DateTime @updatedAt
}

/// Внешние ID аниме для серверных интеграций (например AniSkip требует MAL ID)
model AnimeExternalIdMap {
  shikimoriId Int      @id
  malId       Int?
  source      String   @default("shikimori-graphql")
  syncedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([malId])
}

/// Тайминги пропуска OP/ED/recap из внешних источников (AniSkip)
model AnimeEpisodeSkipTime {
  id             String   @id @default(cuid())
  shikimoriId    Int
  malId          Int
  seasonNumber   Int      @default(1)
  episodeNumber  Int
  episodeLength  Float
  provider       String   @default("aniskip")
  skipType       String
  startTime      Float
  endTime        Float
  externalSkipId String?
  syncedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([provider, malId, seasonNumber, episodeNumber, episodeLength, skipType, startTime])
  @@index([shikimoriId, seasonNumber, episodeNumber])
  @@index([malId, episodeNumber])
}

/// Discord Rich Presence (Application ID из Developer Portal)
model DiscordSettings {
  id                String   @id @default("default")
  applicationId     String?
  largeImageKey     String   @default("logo")
  bridgeDownloadUrl String?
  updatedAt         DateTime @updatedAt
}

/// Настройки сайта по умолчанию для новых пользователей и «Сбросить всё»
model SiteSettingsDefaults {
  id        String   @id @default("default")
  settings  Json
  updatedAt DateTime @updatedAt
}

/// Порог автоудаления из истории просмотра (последняя серия сезона)
model WatchHistorySettings {
  id                          String   @id @default("default")
  completeEpisodeThresholdPct Int      @default(50)
  updatedAt                   DateTime @updatedAt
}

/// Настройки поиска на сайте
model SearchSettings {
  id                     String   @id @default("default")
  headerSearchDebounceMs Int      @default(1500)
  updatedAt              DateTime @updatedAt
}

/// Ротация бренд-логотипов из public/brand-logos
model BrandRotationSettings {
  id              String   @id @default("default")
  enabled         Boolean  @default(true)
  intervalMinutes Int      @default(120)
  rotationSeed    String   @default("default")
  updatedAt       DateTime @updatedAt
}

/// Принудительное смещение интро по озвучкам (перекрывает настройки пользователей)
model TranslationIntroSettings {
  id            String   @id @default("default")
  forcedOffsets Json     @default("{}")
  updatedAt     DateTime @updatedAt
}

/// API уведомлений (Telegram, VK, Discord DM, Web Push VAPID)
model NotificationSettings {
  id                              String   @id @default("default")
  telegramBotToken                String?  @db.Text
  telegramBotUsername             String?
  vkBotToken                      String?  @db.Text
  vkGroupId                       String?
  vkGroupScreenName               String?
  vapidPublicKey                  String?  @db.Text
  vapidPrivateKey                 String?  @db.Text
  vapidSubject                    String?
  discordNotificationClientId     String?
  discordNotificationClientSecret String?  @db.Text
  discordNotificationBotToken     String?  @db.Text
  /// Сервер Discord, куда бот добавляет пользователя при привязке (нужен для DM)
  discordNotificationGuildId      String?
  /// Постоянная ссылка-приглашение на сервер (если пусто — создаётся ботом)
  discordNotificationInviteUrl    String?
  /// OAuth-ссылка на добавление бота на свой сервер пользователя
  discordNotificationBotInviteUrl String?
  discordTitleTemplate            String?  @db.Text
  discordDescriptionTemplate      String?  @db.Text
  telegramMessageTemplate         String?  @db.Text
  vkMessageTemplate               String?  @db.Text
  updatedAt                       DateTime @updatedAt
}

/// История запусков sync (ручных и автоматических)
model KodikSyncRun {
  id               String    @id @default(cuid())
  trigger          String
  status           String
  checkedMaterials Int       @default(0)
  updatedMaterials Int       @default(0)
  newReleases      Int       @default(0)
  error            String?
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  durationMs       Int?

  @@index([startedAt(sort: Desc)])
  @@index([trigger, startedAt(sort: Desc)])
}

/// Состояние полного импорта (можно продолжить после остановки)
model KodikImportJob {
  id               String   @id @default("full")
  phase            String   @default("catalog")
  nextPageUrl      String?
  processed        Int      @default(0)
  total            Int?
  status           String   @default("idle")
  lastError        String?
  currentItem      String?
  sessionProcessed Int      @default(0)
  sessionSkipped   Int      @default(0)
  sessionTotal     Int?
  sessionStartedAt DateTime?
  sessionBaselineProcessed Int @default(0)
  lastItemsPerSecond Float?
  updatedAt        DateTime @updatedAt
}

/// Один материал Kodik = одно аниме + одна озвучка (как в API Kodik)
model KodikMaterial {
  kodikId          String    @id
  shikimoriId      Int?
  type             String
  title            String
  titleOrig        String?
  otherTitle       String?
  year             Int?
  quality          String?
  playerLink       String?
  lastSeason       Int?
  lastEpisode      Int?
  episodesCount    Int?
  translationId    Int
  translationTitle String
  translationType  String
  kodikCreatedAt   DateTime?
  kodikUpdatedAt   DateTime?
  episodesLoaded   Boolean   @default(false)
  materialData     Json?
  seasons          KodikSeason[]
  episodes         KodikEpisode[]
  releases         KodikEpisodeRelease[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([shikimoriId])
  @@index([kodikUpdatedAt(sort: Desc)])
  @@index([shikimoriId, kodikUpdatedAt(sort: Desc)])
  @@index([translationId])
  @@index([episodesLoaded])
}

model KodikSeason {
  id           String        @id @default(cuid())
  materialId   String
  material     KodikMaterial @relation(fields: [materialId], references: [kodikId], onDelete: Cascade)
  seasonNumber Int
  playerLink   String?
  episodes     KodikEpisode[]

  @@unique([materialId, seasonNumber])
}

/// Каждая серия каждой озвучки (как seasons.episodes в Kodik)
model KodikEpisode {
  id            String        @id @default(cuid())
  materialId    String
  material      KodikMaterial @relation(fields: [materialId], references: [kodikId], onDelete: Cascade)
  seasonId      String?
  season        KodikSeason?  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonNumber  Int
  episodeNumber Int
  playerLink    String
  title         String?
  screenshots   Json?
  firstSeenAt   DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([materialId, seasonNumber, episodeNumber])
  @@index([firstSeenAt(sort: Desc)])
  @@index([materialId, seasonNumber, episodeNumber])
}

/// Лента «новые серии» на главной
model KodikEpisodeRelease {
  id              String        @id @default(cuid())
  shikimoriId     Int?
  materialId      String
  material        KodikMaterial @relation(fields: [materialId], references: [kodikId], onDelete: Cascade)
  seasonNumber    Int
  episodeNumber   Int
  translationId   Int
  translationName String
  animeTitle      String
  posterUrl       String?
  playerLink      String?
  releasedAt      DateTime      @default(now())

  @@unique([materialId, seasonNumber, episodeNumber])
  @@index([releasedAt(sort: Desc)])
  @@index([shikimoriId])
  @@index([shikimoriId, releasedAt(sort: Desc)])
  @@index([materialId, seasonNumber, episodeNumber])
}

/// Пользователь (вход через Shikimori OAuth)
model User {
  id                 String               @id @default(cuid())
  shikimoriId        Int                  @unique
  nickname           String
  avatar             String?
  isAdmin            Boolean              @default(false)
  siteSettings       Json?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  account            ShikimoriAccount?
  sessions           Session[]
  listSync           UserListSync?
  animeListEntries   UserAnimeListEntry[]
  animeBookmarks     UserAnimeBookmark[]
  watchProgress      UserWatchProgress[]
  recentAnimeOpens   UserRecentAnimeOpen[]
  siteFriendsOutgoing SiteFriend[] @relation("SiteFriendsOutgoing")
  siteFriendsIncoming SiteFriend[] @relation("SiteFriendsIncoming")
  notificationPreferences UserNotificationPreferences?
  notificationLink        UserNotificationLink?
  pushSubscriptions       PushSubscription[]
}

/// Настройки уведомлений пользователя
model UserNotificationPreferences {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  historyNewEnabled Boolean  @default(false)
  browserEnabled    Boolean  @default(false)
  telegramEnabled   Boolean  @default(false)
  vkEnabled         Boolean  @default(false)
  discordEnabled    Boolean  @default(false)
  /// Личный шаблон Discord (если включён — вместо шаблона сайта)
  customDiscordTemplateEnabled   Boolean @default(false)
  discordTitleTemplate           String? @db.Text
  discordDescriptionTemplate     String? @db.Text
  /// Личный шаблон Telegram
  customTelegramTemplateEnabled  Boolean @default(false)
  telegramMessageTemplate        String? @db.Text
  /// Личный шаблон VK
  customVkTemplateEnabled        Boolean @default(false)
  vkMessageTemplate              String? @db.Text
  updatedAt         DateTime @updatedAt
}

/// Привязка внешних каналов (Telegram chat id, VK user id, Discord user id)
model UserNotificationLink {
  userId             String    @id
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramChatId     String?   @unique
  vkUserId           String?   @unique
  discordUserId      String?   @unique
  discordDmVerified  Boolean   @default(false)
  linkToken          String?   @unique
  linkTokenExpiresAt DateTime?
  updatedAt          DateTime  @updatedAt
}

/// Web Push подписка браузера
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
  @@index([userId])
}

/// Дедуп: уже отправленные уведомления «новое в истории»
model HistoryNewNotification {
  id            String   @id @default(cuid())
  userId        String
  materialId    String
  seasonNumber  Int
  episodeNumber Int
  notifiedAt    DateTime @default(now())

  @@unique([userId, materialId, seasonNumber, episodeNumber])
  @@index([userId])
}

/// Очередь доставки (retry для внешних каналов)
model NotificationDelivery {
  id            String    @id @default(cuid())
  userId        String
  channel       String
  materialId    String
  seasonNumber  Int
  episodeNumber Int
  status        String    @default("pending")
  attempts      Int       @default(0)
  lastError     String?   @db.Text
  createdAt     DateTime  @default(now())
  sentAt        DateTime?

  @@index([status, createdAt])
  @@index([userId])
}

/// Локальная дружба на Track Anime (не синхронизируется с Shikimori)
model SiteFriend {
  id         String   @id @default(cuid())
  fromUserId String
  fromUser   User     @relation("SiteFriendsOutgoing", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("SiteFriendsIncoming", fields: [toUserId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId])
}

/// Метаданные последней синхронизации списков с Shikimori
model UserListSync {
  userId             String    @id
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSyncedAt       DateTime?
  lastSyncError      String?
  mangaBookmarkCount Int       @default(0)
  updatedAt          DateTime  @updatedAt
}

/// Локальная копия записи списка аниме пользователя (Shikimori user_rates)
model UserAnimeListEntry {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shikimoriId     Int
  shikimoriRateId Int?
  listStatus      String
  userScore       Int       @default(0)
  watchedEpisodes Int       @default(0)
  rewatches       Int       @default(0)
  addedAt         DateTime?
  listUpdatedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, shikimoriId])
  @@index([userId, listStatus])
  @@index([userId, listUpdatedAt(sort: Desc)])
}

/// Локальная копия закладок аниме (Shikimori favourites)
model UserAnimeBookmark {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shikimoriId Int
  createdAt   DateTime @default(now())

  @@unique([userId, shikimoriId])
  @@index([userId])
}

/// OAuth-токены Shikimori (только на сервере)
model ShikimoriAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  expiresAt    DateTime
  scope        String
  updatedAt    DateTime @updatedAt
}

/// Серверная сессия (httpOnly cookie)
model Session {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

/// Прогресс просмотра (последняя позиция по каждому тайтлу)
model UserWatchProgress {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shikimoriId     Int
  kodikId         String
  seasonNumber    Int      @default(1)
  episodeNumber   Int      @default(1)
  positionSeconds Float    @default(0)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([userId, shikimoriId])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([shikimoriId])
  @@index([kodikId])
}

/// Недавно открытые страницы аниме
model UserRecentAnimeOpen {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shikimoriId Int
  title       String
  openedAt    DateTime

  @@unique([userId, shikimoriId])
  @@index([userId, openedAt(sort: Desc)])
  @@index([shikimoriId])
}

/// План разработки (админ to-do)
model AdminTodo {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  importance  Int      @default(50)
  complexity  Int      @default(50)
  status      String   @default("planned")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([importance(sort: Desc)])
}

/// Анонсы Shikimori для вкладки «Анонсы» в календаре
model ShikimoriAnonsEntry {
  shikimoriId    Int       @id
  animeTitle     String
  posterUrl      String?
  kind           String?
  score          String?
  scheduleAt     DateTime?
  scheduleSource String?
  nextEpisode    Int?
  syncedAt       DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([scheduleAt])
}

/// Состояние синхронизации анонсов Shikimori
model ShikimoriAnonsSyncState {
  id          String    @id @default("default")
  lastRunAt   DateTime?
  lastStatus  String?
  entryCount  Int       @default(0)
  error       String?
  updatedAt   DateTime  @updatedAt
}

/// OAuth state (fallback если cookies не сохранились между редиректами)
model OAuthState {
  state       String   @id
  redirectUri String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
}
