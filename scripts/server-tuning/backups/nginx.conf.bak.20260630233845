user www-data;
worker_processes auto;
pid /run/nginx.pid;

events {
	worker_connections 1024;
}

http {
	charset UTF-8;
	sendfile on;
	tcp_nopush on;
	include /etc/nginx/mime.types;
	default_type application/octet-stream;

	access_log /var/log/nginx/access.log;

	log_format ta_timing '$remote_addr - $remote_user [$time_local] "$request" $status $body_bytes_sent rt=$request_time uct=$upstream_connect_time urt=$upstream_response_time "$http_referer" "$http_user_agent"';
	error_log /var/log/nginx/error.log;


# для нового трек анимэ
server {
    listen 80;
    server_name ta.dygdyg.ru;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name ta.dygdyg.ru;

    ssl_certificate /etc/letsencrypt/live/server.dygdyg.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/server.dygdyg.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        access_log /var/log/nginx/ta.dygdyg.timing.log ta_timing;
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120;
        proxy_send_timeout 120;
    }
}


