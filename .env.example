# PostgreSQL (docker-compose по умолчанию)
DATABASE_URL="postgresql://track_anime:track_anime@localhost:5432/track_anime"

# Kodik API — обязателен для npm run kodik:import / kodik:sync
# Токен: https://bd.kodikres.com
KODIK_API_TOKEN="your_kodik_token"
KODIK_API_URL="https://kodik-api.com"

# Сколько страниц /list обрабатывать за один sync (100 записей на страницу)
KODIK_SYNC_PAGES="3"

# User-Agent для запросов к Kodik (опционально)
# KODIK_USER_AGENT="TrackAnime/0.1"

# Production: NODE_ENV="production"

# Dev с телефона/LAN: Next.js блокирует /_next/* без allowedDevOrigins.
# npm run dev слушает 0.0.0.0 — открывайте http://192.168.x.x:3000 (IP ПК в Wi‑Fi).
# Доп. хосты: DEV_ALLOWED_ORIGINS="my-pc.local,dygdyg"
# DEV_ALLOWED_ORIGINS="192.168.1.100"

# Локальное имя dygdyg:3000 — добавьте в hosts (Windows: C:\Windows\System32\drivers\etc\hosts):
#   192.168.1.100  dygdyg
# OAuth Shikimori с LAN/IP не работает (только localhost или HTTPS). Для входа с телефона — production или туннель.

# Shikimori OAuth — https://shikimori.one/oauth/applications
# Redirect URI в Shikimori (правила сайта):
#   http://localhost:3000/api/auth/callback/shikimori  — dev на этом ПК
#   http://127.0.0.1:3000/api/auth/callback/shikimori  — опционально
#   https://ta.dygdyg.ru/api/auth/callback/shikimori  — production (HTTPS обязателен!)
# http://dygdyg.ru:3000 — Shikimori НЕ примет (нужен HTTPS). При dev через домен OAuth уйдёт на localhost.
AUTH_URL="http://localhost:3000"
# Явный redirect URI, если нужен другой (должен совпадать с записью в Shikimori):
# SHIKIMORI_REDIRECT_URI="https://ta.dygdyg.ru/api/auth/callback/shikimori"
SHIKIMORI_CLIENT_ID="your_shikimori_client_id"
SHIKIMORI_CLIENT_SECRET="your_shikimori_client_secret"
# Scope OAuth. По умолчанию user_rates (доступен всем приложениям Shikimori).
# Scope friends/messages/clubs и др. — серые в настройках приложения, пока их не одобрит администратор Shikimori.
# После одобрения friends: включите галочку в приложении и задайте:
# SHIKIMORI_OAUTH_SCOPE="user_rates+friends"
# Имя OAuth-приложения на Shikimori (User-Agent в запросах — должно совпадать!)
# SHIKIMORI_APP_NAME="TrackAnime"
# Хост Shikimori по умолчанию (shikimori.io или shikimori.one). Можно сменить в админке → Shikimori.
# SHIKIMORI_HOST="shikimori.io"
# Таймауты публичных запросов к Shikimori, чтобы страницы не висели при сетевых проблемах.
# SHIKIMORI_REQUEST_TIMEOUT_MS="8000"
# SHIKIMORI_TOTAL_TIMEOUT_MS="15000"

# Discord Rich Presence (локальный мост + ID приложения в Discord Developer Portal)
# NEXT_PUBLIC_DISCORD_APP_ID="your_discord_application_id"
# DISCORD_APP_ID="your_discord_application_id"
# NEXT_PUBLIC_DISCORD_RPC_BRIDGE_URL="http://127.0.0.1:6738"
# NEXT_PUBLIC_DISCORD_RPC_DOWNLOAD_URL="https://ta.dygdyg.ru/downloads/TrackAnimeDiscordRPC.exe"
# DISCORD_RPC_LARGE_IMAGE="logo": Shikimori ID через запятую (получают isAdmin при входе)
# ADMIN_SHIKIMORI_IDS="123456"
