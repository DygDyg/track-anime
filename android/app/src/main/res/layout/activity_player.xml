<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background" />

    <LinearLayout
        android:id="@+id/chrome_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC0C0E14"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/foreground"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/episode_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/chrome_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC0C0E14"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_play_pause"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/settings_btn_accent"
                android:focusable="true"
                android:minWidth="88dp"
                android:text="Пауза"
                android:textAllCaps="false"
                android:textColor="@color/foreground" />

            <Button
                android:id="@+id/btn_seek_back"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/settings_btn_ghost"
                android:focusable="true"
                android:text="−10"
                android:textAllCaps="false"
                android:textColor="@color/foreground" />

            <Button
                android:id="@+id/btn_seek_fwd"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/settings_btn_ghost"
                android:focusable="true"
                android:text="+10"
                android:textAllCaps="false"
                android:textColor="@color/foreground" />

            <Button
                android:id="@+id/btn_skip"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/settings_btn_accent"
                android:focusable="true"
                android:text="Пропустить"
                android:textAllCaps="false"
                android:textColor="@color/foreground"
                android:visibility="gone" />

            <TextView
                android:id="@+id/time_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <android.widget.SeekBar
            android:id="@+id/seek_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="1000" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_episodes"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/settings_btn_ghost"
                    android:focusable="true"
                    android:text="Серии"
                    android:textAllCaps="false"
                    android:textColor="@color/foreground" />

                <Button
                    android:id="@+id/btn_translations"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/settings_btn_ghost"
                    android:focusable="true"
                    android:text="Озвучка"
                    android:textAllCaps="false"
                    android:textColor="@color/foreground" />

                <Button
                    android:id="@+id/btn_quality"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/settings_btn_ghost"
                    android:focusable="true"
                    android:text="Качество"
                    android:textAllCaps="false"
                    android:textColor="@color/foreground" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/continue_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60C0E14"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/continue_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/foreground"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_continue"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/settings_btn_accent"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:minWidth="140dp"
                android:text="Продолжить"
                android:textAllCaps="false"
                android:textColor="@color/foreground" />

            <Button
                android:id="@+id/btn_from_start"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/settings_btn_ghost"
                android:focusable="true"
                android:minWidth="140dp"
                android:text="С начала"
                android:textAllCaps="false"
                android:textColor="@color/foreground" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/error_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="#FF8A8A"
        android:textSize="15sp"
        android:visibility="gone" />
</FrameLayout>
