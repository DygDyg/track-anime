<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TrackAnime" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:alertDialogTheme">@style/Theme.TrackAnime.Dialog</item>
    </style>

    <!-- Matches SiteSettingsModal dark card: #141824 / accent #6c8cff -->
    <style name="Theme.TrackAnime.Dialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorBackground">@color/card</item>
        <item name="android:windowBackground">@drawable/settings_dialog_bg</item>
        <item name="android:textColorPrimary">@color/foreground</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/Theme.TrackAnime.Dialog.Button.Accent</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/Theme.TrackAnime.Dialog.Button.Muted</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/Theme.TrackAnime.Dialog.Button.Muted</item>
    </style>

    <style name="Theme.TrackAnime.Dialog.Button.Accent" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Theme.TrackAnime.Dialog.Button.Muted" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
