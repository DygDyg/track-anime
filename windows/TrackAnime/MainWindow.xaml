<Window x:Class="TrackAnime.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Track Anime"
        Icon="Assets/app.ico"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        Background="#0C0E14"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="#FF0C0E14" />

    <Border x:Name="BootstrapOverlay"
            Background="#0C0E14"
            Visibility="Visible">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28">
        <TextBlock Text="Track Anime"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#EEF0F4"
                   HorizontalAlignment="Center" />
        <ProgressBar IsIndeterminate="True"
                     Width="220"
                     Height="4"
                     Margin="0,28,0,0"
                     Foreground="#6C8CFF"
                     Background="#1A1F2C"
                     BorderThickness="0" />
        <TextBlock x:Name="BootstrapStatus"
                   Text="Поиск рабочего зеркала…"
                   FontSize="14"
                   Foreground="#A3ABBD"
                   TextAlignment="Center"
                   Margin="0,18,0,0"
                   TextWrapping="Wrap"
                   MaxWidth="420" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
