{
  "name": "track-anime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "node scripts/prisma-generate-safe.mjs && next dev --hostname 0.0.0.0",
    "dev:localhost": "node scripts/prisma-generate-safe.mjs && next dev",
    "dev:custom": "node scripts/prisma-generate-safe.mjs && next dev --experimental-https",
    "dev:with-port": "node scripts/prisma-generate-safe.mjs && next dev -p $PORT",
    "build": "node scripts/sync-brand-assets.mjs && next build && node scripts/write-build-info.mjs",
    "brand:sync": "node scripts/sync-brand-assets.mjs",
    "android:brand:sync": "node scripts/sync-android-brand-assets.mjs",
    "avatar-decorations:thumbs": "tsx scripts/generate-avatar-decoration-thumbs.ts",
    "start": "next start",
    "watch-party:server": "node scripts/watch-party-server.mjs",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:push:schema": "prisma db push --skip-generate",
    "db:studio": "prisma studio",
    "db:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-db.ps1",
    "db:pull-prod": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pull-prod-db.ps1",
    "db:restore-prod": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pull-prod-db.ps1 -Restore",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "kodik:import": "tsx scripts/kodik-import-full.ts",
    "kodik:import:resume": "tsx scripts/kodik-import-full.ts --resume",
    "kodik:import:episodes": "tsx scripts/kodik-import-full.ts --episodes-only",
    "kodik:sync": "tsx scripts/kodik-sync-recent.ts",
    "kodik:sync:scheduled": "tsx scripts/kodik-sync-scheduled.ts",
    "kodik:normalize-metadata": "tsx scripts/normalize-kodik-material-metadata.ts",
    "kodik:normalize-metadata:write": "tsx scripts/normalize-kodik-material-metadata.ts --write --quiet",
    "shikimori:sync-anons": "tsx scripts/shikimori-sync-anons.ts",
    "shikimori:malid-stats": "tsx scripts/shikimori-malid-stats.ts",
    "kodik:backfill-dates": "tsx scripts/kodik-backfill-release-dates.ts",
    "import:sqlite-history": "node scripts/import-sqlite-watch-history.mjs --create-users",
    "import:sqlite-history:merge": "node scripts/import-sqlite-watch-history.mjs --skip-existing",
    "users:backfill-profiles": "tsx scripts/backfill-user-profiles.ts",
    "discord:bridge": "node scripts/discord-rpc-bridge.mjs",
    "discord:tray": "electron scripts/discord-rpc-tray/main.mjs",
    "discord:tray:build": "electron-builder --project scripts/discord-rpc-tray --win portable",
    "discord:tray:publish": "npm run discord:tray:build && node scripts/publish-discord-tray-exe.mjs",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "deploy:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1 -ForceTrayRebuild",
    "deploy:rpc": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-rpc.ps1",
    "notifications:generate-vapid": "tsx scripts/generate-vapid-keys.ts",
    "notifications:telegram-bot": "tsx scripts/telegram-notification-bot.ts",
    "notifications:vk-bot": "tsx scripts/vk-notification-bot.ts",
    "notifications:worker": "tsx scripts/notification-worker.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "@types/qrcode": "^1.5.6",
    "dotenv": "^16.5.0",
    "next": "^16.2.9",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7",
    "ws": "^7.5.11"
  },
  "devDependencies": {
    "@serwist/turbopack": "^9.5.11",
    "@swc/helpers": "^0.5.23",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.5.0",
    "discord-rpc": "^4.0.1",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "postcss": "^8.5.15",
    "prisma": "^6.9.0",
    "serwist": "^9.5.11",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
